{
  "hosting": {
    "site": "dark-coin-arena-dev",
    "public": "public",
    "ignore": [
      "firebase*.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "arenaDevWeb",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions-arena-dev",
      "codebase": "arena-dev",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*.local"
      ]
    }
  ]
}
