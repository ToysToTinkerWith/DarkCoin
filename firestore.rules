rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cards/{cardId} {
      allow read: if true;
      allow write: if false;
    }

    match /monsters/{monsterId} {
      allow read: if true;
      allow write: if false;
    }

    match /depthsRuns/{runId} {
      allow read: if true;
      allow write: if false;
    }

    match /depthsBattles/{battleId} {
      allow read: if true;
      allow write: if false;
    }

    match /depthsRewardClaims/{claimId} {
      allow read, write: if false;
    }

    match /{collection}/{document=**} {
      // Server-only room state includes RNG and session/ownership proofs.
      // A broad allow elsewhere would override a narrower deny.
      allow read: if collection != 'arenaPrivate';
      allow write: if
        collection != 'arenaPrivate' &&
        request.auth != null &&
        request.auth.token.email == 'abergquist96@gmail.com';
    }
  }
}
